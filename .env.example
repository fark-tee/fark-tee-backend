PORT="8080"
MONGODB_URI="mongodb://root:root@localhost:27017"
MONGODB_DATABASE="fark_tee"

LOG_LEVEL="debug"
LOG_FORMAT="TEXT"

INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URL="http://localhost:8080/v1/auth/instagram/callback"

CORS_ALLOWED_ORIGINS="http://localhost:8080"
CORS_ALLOWED_METHODS="GET,HEAD,POST,PUT,PATCH,DELETE"
CORS_ALLOWED_HEADERS="Authorization,Content-Type,Accept,Origin,User-Agent,X-Requested-With,Access-Control-Allow-Origin,X-Request-ID"
CORS_EXPOSED_HEADERS="X-Request-ID,Content-Length,Content-Type,Date,Server"
CORS_ALLOW_CREDENTIALS="true"
CORS_MAX_AGE="300"

# S3-compatible storage (MinIO in docker-compose.yml)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="fark-tee"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
