PORT="8080"
MONGODB_URI="mongodb://root:root@localhost:27017"
MONGODB_DATABASE="fark_tee"

LOG_LEVEL="debug"
LOG_FORMAT="TEXT"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URL="http://localhost:8080/v1/auth/google/callback"

JWT_SECRET=""
JWT_TTL="24h"
JWT_REFRESH_TTL="720h"

# Comma-separated list of redirect_uri prefixes the backend is allowed to
# redirect to, e.g. the mobile app's deeplink scheme plus a local web URL for
# debugging: "farktee://,http://localhost:3000"
ALLOWED_REDIRECT_PREFIXES="farktee://"

CORS_ALLOWED_ORIGINS="http://localhost:8080"
CORS_ALLOWED_METHODS="GET,HEAD,POST,PUT,PATCH,DELETE"
CORS_ALLOWED_HEADERS="Authorization,Content-Type,Accept,Origin,User-Agent,X-Requested-With,Access-Control-Allow-Origin,X-Request-ID"
CORS_EXPOSED_HEADERS="X-Request-ID,Content-Length,Content-Type,Date,Server"
CORS_ALLOW_CREDENTIALS="true"
CORS_MAX_AGE="300"

# S3-compatible storage (MinIO in docker-compose.yml)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="fark-tee"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

GOOGLE_APPLICATION_CREDENTIALS="credential.json"

# OSRM routing server used to estimate trip travel time (docker-compose.yml
# for a self-hosted instance, or point at a hosted OSRM deployment). The
# public demo server below is rate-limited and driving-profile only - do not
# rely on it in production.
OSRM_BASE_URL="http://localhost:5001"
OSRM_PROFILE="driving"